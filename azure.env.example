# Copy to .env (git-ignored, and unreadable to agents by .claude/settings.json) for local runs against real models.
# Leave everything unset to use the offline stub (what tests and PR CI do).

# --- RAG answers: Claude on Microsoft Foundry ---
RAG_LLM_PROVIDER=foundry
RAG_LLM_MODEL=claude-opus-5-5                  # your Foundry deployment name
ANTHROPIC_FOUNDRY_RESOURCE=foundry-ankit-resource
ANTHROPIC_FOUNDRY_API_KEY=                     # Foundry resource -> Keys and Endpoint

# --- Judge + RAGAS: a GPT deployment (different model family) ---
RAG_JUDGE_PROVIDER=azure_openai
RAG_JUDGE_MODEL=gpt-5
RAG_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_ENDPOINT=                         # copy from "Get code" on the gpt-5 deployment
OPENAI_API_VERSION=                            # copy from "Get code" too
AZURE_OPENAI_API_KEY=
